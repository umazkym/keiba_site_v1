{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "design:audit": "node scripts/design-audit.js",
    "structured-data:test": "npx --yes tsx scripts/test_dataset_schema.ts",
    "affiliate:test": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/agent_sops/run_node.ps1 frontend/scripts/test_affiliate_campaigns.js",
    "article:pipeline": "npx --yes tsx scripts/agents/test_pipeline.ts",
    "article:publish": "npx --yes tsx scripts/agents/agent_publisher.ts",
    "article:validate-links": "node -e \"eval(require('fs').readFileSync('scripts/agents/validate_article_links.js','utf8'))\"",
    "article:audit-quality": "node -e \"eval(require('fs').readFileSync('scripts/agents/article_quality_audit.js','utf8'))\"",
    "article:audit-race-bridges": "npx --yes tsx scripts/agents/audit_article_race_bridges.ts",
    "article:audit-race-bridges:offline": "npx --yes tsx scripts/agents/audit_article_race_bridges.ts --offline",
    "article:remediate-independence": "node scripts/agents/remediate_source_independence.js",
    "article:remediate-independence:apply": "node scripts/agents/remediate_source_independence.js --apply",
    "article:test-independence": "npx --yes tsx scripts/agents/test_source_independence.ts",
    "article:test-routing": "npx --yes tsx scripts/agents/test_article_seasonal_routing.ts",
    "article:test-race-bridge": "npx --yes tsx scripts/agents/test_article_race_bridge.ts",
    "analytics:test-monetization": "npx --yes tsx scripts/agents/test_monetization_context.ts",
    "article:test-order-priority": "npx --yes tsx scripts/agents/test_article_order_priority.ts",
    "gsc:export-inventory": "npx --yes tsx scripts/agents/export_gsc_article_inventory.ts",
    "gsc:rewrite": "npx --yes tsx scripts/agents/gsc_seo_rewrite.ts",
    "gsc:test-rewrite": "npx --yes tsx scripts/agents/test_gsc_seo_rewrite.ts",
    "article:tone-fix": "node scripts/agents/improve_article_tone.js",
    "article:tone-fix:apply": "node scripts/agents/improve_article_tone.js --apply",
    "article:tone-audit": "node scripts/agents/article_quality_audit.js --json | node -e \"const d=JSON.parse(require('fs').readFileSync('/dev/stdin','utf8')); console.log('Critical:', d.summary.critical, '/ Warning:', d.summary.warning);\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@next/third-parties": "^15.5.4",
    "@tippyjs/react": "^4.2.6",
    "chart.js": "^4.4.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.544.0",
    "next": "^14.2.31",
    "react": "^18",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "react-tabs": "^6.0.2",
    "recharts": "^3.0.2",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-tabs": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^8",
    "eslint-config-next": "14.2.4",
    "postcss": "^8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
